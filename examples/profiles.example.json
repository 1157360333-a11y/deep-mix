{
  "version": 1,
  "profiles": {
    "deepseek_governor": {
      "provider": "deepseek",
      "role": "governor",
      "apiKeyEnvName": "DEEPSEEK_API_KEY",
      "baseUrl": "https://api.deepseek.com",
      "chatPath": "/chat/completions",
      "model": "deepseek-v4-flash",
      "supportsMultimodalInput": false,
      "headers": {
        "Content-Type": "application/json"
      },
      "requestDefaults": {},
      "notes": "Required. Confirm the current model name in the provider documentation."
    },
    "glm_coding_worker": {
      "provider": "glm",
      "role": "coding_worker",
      "apiKeyEnvName": "GLM_API_KEY",
      "baseUrl": "https://api.example.invalid/v1",
      "chatPath": "/chat/completions",
      "model": "replace-with-your-glm-model",
      "supportsMultimodalInput": false,
      "headers": {
        "Content-Type": "application/json"
      },
      "requestDefaults": {},
      "notes": "Optional worker. Replace the endpoint and model before forcing glm_coding."
    },
    "kimi_vision": {
      "provider": "kimi",
      "role": "vision_worker",
      "apiKeyEnvName": "KIMI_API_KEY",
      "baseUrl": "https://api.example.invalid/v1",
      "chatPath": "/chat/completions",
      "model": "replace-with-your-kimi-vision-model",
      "supportsMultimodalInput": true,
      "headers": {
        "Content-Type": "application/json"
      },
      "requestDefaults": {},
      "notes": "Optional worker. Replace the endpoint and model before forcing kimi_vision."
    }
  }
}
